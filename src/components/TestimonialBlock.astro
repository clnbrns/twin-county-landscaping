---
import { SITE } from '../data/site';
// Google reviews link — update when GBP is verified
const reviewsUrl = SITE.googleReviewsUrl ?? 'https://www.google.com/search?q=Twin+County+Outdoor+Services+Aledo+reviews';
---
<section class="bg-brand-green-tint">
  <div class="container-x py-16 text-center">
    <div class="text-brand-green-dark text-2xl mb-2">★★★★★</div>
    <h2>5-Star Rated on Google</h2>
    <p class="mt-3 text-brand-muted max-w-2xl mx-auto">Every review on Google is 5 stars. Read what homeowners across Aledo, Benbrook, Weatherford, Fort Worth and Western DFW have to say about working with Lucas and the Twin County crew.</p>
    <a href={reviewsUrl} target="_blank" rel="noopener" class="btn-secondary mt-6 inline-flex no-underline">Read our Google reviews →</a>
  </div>
</section>
