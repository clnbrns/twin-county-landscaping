---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import QuoteForm from '../components/QuoteForm.astro';
import CTABanner from '../components/CTABanner.astro';
import GeoLinks from '../components/GeoLinks.astro';

const title = 'Landscape Design in Stephenville, TX | Twin County Outdoor Services';
const description = 'Landscape design and landscaping in Stephenville, TX. Acreage landscape plans, plant selection, hardscape, drainage, and installation by one local crew. In-person quotes, written proposals.';
const path = '/landscape-design-stephenville-tx';

const services = [
  { name: 'Full landscape design', body: 'Walk, measure, plan. Plant palette, hardscape layout, drainage integration — written proposal with everything itemized.' },
  { name: 'Acreage & ranch-entrance design', body: 'Larger Erath County lots and ranch entrances designed at the right scale — not a suburban plan stretched thin over acreage.' },
  { name: 'Backyard transformations', body: 'Complete backyard remodels — patio, walls, plantings, sod, drainage, lighting. One crew, one timeline, no subcontractor handoffs.' },
  { name: 'Front yard refreshes', body: 'Curb appeal projects — new beds, stone borders, layered seasonal color, refreshed entry approach. Most done in 2–4 days.' },
  { name: 'Plant selection for Erath County', body: 'Texas natives and drought-tolerant ornamentals suited to Stephenville\'s soil and summer heat.' },
  { name: 'Integrated drainage', body: 'Every design includes drainage planning. French drains and surface drains routed before any planting — not bolted on after.' },
];

const process = [
  { step: '1', title: 'In-person walkthrough', body: 'Lucas comes to your Stephenville property, walks the yard or acreage, takes measurements and photos, listens to how you use the space.' },
  { step: '2', title: 'Written proposal', body: 'Detailed scope, plant palette, hardscape materials, phasing options, realistic timeline. You see exactly what you are paying for.' },
  { step: '3', title: 'Design refinement', body: 'We iterate together before any work starts — easy to adjust scope, materials, or phasing.' },
  { step: '4', title: 'One-crew installation', body: 'Same team handles excavation, hardscape, drainage, plantings, sod, cleanup. No surprise upcharges, no finger-pointing between trades.' },
];

const galleryImages = [
  { src: '/images/services/landscape-design/favorite-1-gallery.webp', alt: 'Landscape design project in Stephenville' },
  { src: '/images/services/landscape-design/favorite-2-gallery.webp', alt: 'Backyard transformation in Stephenville' },
  { src: '/images/services/landscape-design/img-0268-gallery.webp', alt: 'Full landscape installation' },
  { src: '/images/services/landscape-design/img-0671-gallery.webp', alt: 'Front yard flower bed design' },
  { src: '/images/projects/benbrook-terraced-garden-walls/img-1999-gallery.webp', alt: 'Terraced backyard transformation' },
  { src: '/images/projects/benbrook-flagstone-patio/img-2230-gallery.webp', alt: 'Backyard patio and landscape design' },
];

const neighborhoods = ['Stephenville proper', 'Tarleton area', 'Erath County acreage'];

const faqs = [
  { q: 'How much does a landscape design cost in Stephenville?', a: 'Most full landscape designs in Stephenville run $8,000–$40,000 installed depending on scope. Acreage and ranch-entrance projects vary more widely based on scale. Front-yard refreshes start around $3,500.' },
  { q: 'Do you charge for the design?', a: 'No. Design is included in the project. Lucas walks the property and writes a detailed proposal at no cost.' },
  { q: 'Do you take on acreage and ranch properties, not just standard lots?', a: 'Yes — acreage and ranch-entrance design is a regular part of our Stephenville and Erath County work, sized appropriately rather than treated like a standard subdivision lot.' },
  { q: 'What does a full landscape project actually include?', a: 'Whatever your yard needs: patio, retaining walls, plant beds, sod, drainage, lighting, fire features, irrigation. We design and install as a complete system, not a list of disconnected upgrades.' },
  { q: 'Do you offer routine lawn mowing or maintenance in Stephenville?', a: "No — we focus on design, installation, and renovation projects, not recurring lawn care. If you need a full landscape built or reworked, that's our lane." },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Landscape Design and Installation',
  provider: { '@id': 'https://twincountyoutdoorservices.com/#business' },
  areaServed: { '@type': 'City', name: 'Stephenville', containedInPlace: { '@type': 'State', name: 'Texas' } },
  description,
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Base title={title} description={description} path={path} schema={[schema, faqSchema]}>
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Services', href: '/services' }, { label: 'Landscape Design Stephenville' }]} />

  <section class="container-x py-12">
    <h1>Landscape Design in Stephenville, TX</h1>
    <p class="mt-4 text-lg text-brand-muted max-w-3xl">
      Full landscape design, acreage and ranch-entrance plans, backyard transformations, and front-yard refreshes across Stephenville and Erath County. In-person quotes, detailed written proposals — same drive we make for our Aledo customers.
    </p>

    <div class="mt-8 grid lg:grid-cols-3 gap-10">
      <div class="lg:col-span-2 space-y-10">
        <div class="aspect-[16/10] bg-brand-green-tint rounded-lg overflow-hidden">
          <img src="/images/services/landscape-design/favorite-1-gallery.webp" alt="Landscape design in Stephenville, TX" width="1600" height="1000" class="w-full h-full object-cover" />
        </div>

        <div>
          <h2>What we design and install</h2>
          <div class="mt-5 grid sm:grid-cols-2 gap-5">
            {services.map((s) => (
              <div class="bg-white border border-brand-green-tint rounded-lg p-5">
                <h3 class="text-lg font-semibold text-brand-ink">{s.name}</h3>
                <p class="mt-2 text-brand-muted text-sm">{s.body}</p>
              </div>
            ))}
          </div>
        </div>

        <div>
          <h2>Our design process</h2>
          <div class="mt-5 grid sm:grid-cols-2 gap-4">
            {process.map((p) => (
              <div class="bg-brand-green-tint/30 rounded-lg p-5">
                <div class="text-brand-green-dark font-bold text-2xl">{p.step}</div>
                <h3 class="text-lg font-semibold text-brand-ink mt-1">{p.title}</h3>
                <p class="mt-2 text-brand-muted text-sm">{p.body}</p>
              </div>
            ))}
          </div>
        </div>

        <div>
          <h2>Stephenville areas we serve</h2>
          <div class="mt-4 flex flex-wrap gap-2">
            {neighborhoods.map((n) => <span class="px-3 py-1 bg-brand-green-tint text-brand-ink rounded-full text-sm">{n}</span>)}
          </div>
        </div>

        <div>
          <h2>Recent Stephenville-area work</h2>
          <div class="mt-4 grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4">
            {galleryImages.map((img) => (
              <a href={img.src} class="block aspect-square bg-brand-green-tint rounded-md overflow-hidden">
                <img src={img.src} alt={img.alt} loading="lazy" width="800" height="800" class="w-full h-full object-cover" />
              </a>
            ))}
          </div>
        </div>

        <div>
          <h2>Stephenville landscape design FAQs</h2>
          <div class="mt-4 space-y-5">
            {faqs.map((f) => (
              <div class="border-l-4 border-brand-green-dark pl-4">
                <h3 class="text-lg font-semibold text-brand-ink">{f.q}</h3>
                <p class="mt-2 text-brand-muted">{f.a}</p>
              </div>
            ))}
          </div>
        </div>

        <GeoLinks currentPath={path} />
      </div>

      <aside class="lg:sticky lg:top-24 lg:self-start"><QuoteForm compact /></aside>
    </div>
  </section>

  <CTABanner title="Ready to design your Stephenville property?" />
</Base>
