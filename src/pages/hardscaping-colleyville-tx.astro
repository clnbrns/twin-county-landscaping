---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import QuoteForm from '../components/QuoteForm.astro';
import CTABanner from '../components/CTABanner.astro';
import GeoLinks from '../components/GeoLinks.astro';

const title = 'Hardscape Contractors in Colleyville, TX | Twin County Outdoor Services';
const description = 'Hardscape contractors in Colleyville, TX — paver patios, flagstone, walkways, and outdoor living installations for larger Northeast Tarrant County lots. Free in-person quote.';
const path = '/hardscaping-colleyville-tx';

const services = [
  { name: 'Paver patios', body: 'Belgard and Pavestone segmental pavers on a properly compacted base — sized for Colleyville\'s larger backyard footprints.' },
  { name: 'Flagstone patios & walkways', body: 'Oklahoma flagstone and Texas-quarried stone with mortared or polymeric-sand joints for a premium, natural finish.' },
  { name: 'Outdoor living installations', body: 'Seating walls, fire pits, and pergola-ready patios built as one integrated system, not decorative add-ons.' },
  { name: 'Entrance & walkway hardscape', body: 'Stone and paver walkways connecting driveways, entries, and side yards on Colleyville\'s bigger corner lots.' },
  { name: 'Pool-area hardscape', body: 'Paver and flagstone decking around pools and spas, detailed for drainage away from the pool shell.' },
  { name: 'Drainage built in', body: 'Every patio includes grading or a French drain sized to the property — not an afterthought once water starts pooling.' },
];

const galleryImages = [
  { src: '/images/services/hardscaping/img-1058-gallery.webp', alt: 'Hardscape patio installation in Colleyville' },
  { src: '/images/services/hardscaping/img-1164-gallery.webp', alt: 'Flagstone patio project' },
  { src: '/images/services/hardscaping/img-1261-gallery.webp', alt: 'Paver patio detail' },
  { src: '/images/services/hardscaping/img-1462-gallery.webp', alt: 'Stone walkway installation' },
  { src: '/images/services/hardscaping/img-1800-gallery.webp', alt: 'Backyard hardscape patio' },
  { src: '/images/services/hardscaping/img-1805-gallery.webp', alt: 'Outdoor living hardscape' },
];

const faqs = [
  { q: 'Do you take on hardscape projects in Colleyville, TX?', a: 'Yes — Colleyville is a regular part of our Northeast Tarrant County service area, and we take on both standard patios and larger, premium-finish projects.' },
  { q: 'How much does a paver patio cost in Colleyville?', a: 'Most paver patios run $18-$35 per square foot installed; flagstone runs $28-$50 per square foot. Colleyville\'s larger lots often mean bigger overall square footage, which we account for in the proposal.' },
  { q: 'Can you build a full outdoor living space, not just a patio?', a: "Yes — seating walls, fire pits, and pergola-ready hardscape built as one system. We design the patio around how you'll actually use the space, not just pour a slab." },
  { q: 'Do you handle drainage as part of the hardscape project?', a: 'Yes. Every patio and walkway includes grading or a French drain sized to the property, built in from the start rather than added after water starts pooling.' },
  { q: 'Do you offer free quotes for Colleyville projects?', a: 'Yes. Lucas walks the property in person, photographs the site, and writes a detailed proposal at no charge.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Hardscaping',
  provider: { '@id': 'https://twincountyoutdoorservices.com/#business' },
  areaServed: { '@type': 'City', name: 'Colleyville', containedInPlace: { '@type': 'State', name: 'Texas' } },
  description,
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Base title={title} description={description} path={path} schema={[schema, faqSchema]}>
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Services', href: '/services' }, { label: 'Hardscaping Colleyville' }]} />

  <section class="container-x py-12">
    <h1>Hardscape Contractors in Colleyville, TX</h1>
    <p class="mt-4 text-lg text-brand-muted max-w-3xl">
      Paver patios, flagstone patios, walkways, and full outdoor living installations for Colleyville's larger Northeast Tarrant County lots. In-person quotes, detailed written proposals.
    </p>

    <div class="mt-8 grid lg:grid-cols-3 gap-10">
      <div class="lg:col-span-2 space-y-10">
        <div class="aspect-[16/10] bg-brand-green-tint rounded-lg overflow-hidden">
          <img src="/images/services/hardscaping/img-1058-gallery.webp" alt="Hardscape contractor in Colleyville, TX" width="1600" height="1000" class="w-full h-full object-cover" />
        </div>

        <div>
          <h2>What we build in Colleyville</h2>
          <div class="mt-5 grid sm:grid-cols-2 gap-5">
            {services.map((s) => (
              <div class="bg-white border border-brand-green-tint rounded-lg p-5">
                <h3 class="text-lg font-semibold text-brand-ink">{s.name}</h3>
                <p class="mt-2 text-brand-muted text-sm">{s.body}</p>
              </div>
            ))}
          </div>
        </div>

        <div>
          <h2>Recent hardscape work</h2>
          <div class="mt-4 grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4">
            {galleryImages.map((img) => (
              <a href={img.src} class="block aspect-square bg-brand-green-tint rounded-md overflow-hidden">
                <img src={img.src} alt={img.alt} loading="lazy" width="800" height="800" class="w-full h-full object-cover" />
              </a>
            ))}
          </div>
        </div>

        <div>
          <h2>Colleyville hardscaping FAQs</h2>
          <div class="mt-4 space-y-5">
            {faqs.map((f) => (
              <div class="border-l-4 border-brand-green-dark pl-4">
                <h3 class="text-lg font-semibold text-brand-ink">{f.q}</h3>
                <p class="mt-2 text-brand-muted">{f.a}</p>
              </div>
            ))}
          </div>
        </div>

        <p class="text-sm text-brand-muted">Serving Colleyville, Grapevine, Keller, and the rest of Northeast Tarrant County.</p>

        <GeoLinks currentPath={path} />
      </div>

      <aside class="lg:sticky lg:top-24 lg:self-start"><QuoteForm compact /></aside>
    </div>
  </section>

  <CTABanner title="Ready for your Colleyville hardscape project?" />
</Base>
