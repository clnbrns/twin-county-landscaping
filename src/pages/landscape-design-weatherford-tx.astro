---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import QuoteForm from '../components/QuoteForm.astro';
import CTABanner from '../components/CTABanner.astro';

const title = 'Landscape & Backyard Design in Weatherford, TX | Twin County Outdoor Services';
const description = 'Landscape design and backyard design in Weatherford, TX. Full plans, plant selection, hardscape, drainage, and installation by one crew. In-person quotes, written proposals.';
const path = '/landscape-design-weatherford-tx';

const services = [
  { name: 'Full landscape design', body: 'Site walk, measurements, photos, and a written plan. Plant palette, hardscape layout, drainage integration, and irrigation considerations — all in one proposal.' },
  { name: 'Backyard transformations', body: 'Complete backyard remodels — patio, walls, plantings, sod, drainage, lighting. One crew handles every phase from demolition to final cleanup.' },
  { name: 'Front yard refreshes', body: 'Curb appeal projects — refresh tired beds, install new flower beds, add stone borders, layer in seasonal color, and clean up the entry approach.' },
  { name: 'Acreage landscape design', body: 'Weatherford and Parker County acreage often needs different thinking — entrance landscaping, ranch driveways, pasture transitions, and big-impact statement plantings.' },
  { name: 'Plant selection for our soil', body: 'Texas natives and clay-tolerant ornamentals — knockout roses, Texas sage, dwarf yaupon, salvia, lantana, and the trees that survive Weatherford summers.' },
  { name: 'Integrated drainage', body: 'Every design includes drainage planning. French drains and surface drains routed before any planting goes in — not bolted on after.' },
];

const galleryImages = [
  { src: '/images/services/landscape-design/favorite-1-gallery.webp', alt: 'Landscape design project in Weatherford' },
  { src: '/images/services/landscape-design/favorite-2-gallery.webp', alt: 'Backyard design installation' },
  { src: '/images/services/landscape-design/img-0268-gallery.webp', alt: 'Full landscape installation' },
  { src: '/images/services/landscape-design/img-0041-gallery.webp', alt: 'Backyard project detail' },
  { src: '/images/projects/benbrook-terraced-garden-walls/img-1999-gallery.webp', alt: 'Terraced backyard transformation' },
  { src: '/images/projects/benbrook-flagstone-patio/img-2230-gallery.webp', alt: 'Backyard patio and landscape design' },
];

const process = [
  { step: '1', title: 'In-person walkthrough', body: 'Lucas comes to the property, walks the yard, takes measurements and photos, asks about your day-to-day use, and listens.' },
  { step: '2', title: 'Written proposal', body: 'Detailed scope, plant palette, hardscape materials, phasing options, and a realistic timeline. You see exactly what you are paying for.' },
  { step: '3', title: 'Design refinement', body: 'We work through changes together. Want a different patio shape, fewer beds, a fire pit instead of a wall? Easy to iterate before any work starts.' },
  { step: '4', title: 'One-crew installation', body: 'Same team handles excavation, hardscape, drainage, plantings, sod, and final cleanup. No subcontractor handoffs, no surprise upcharges.' },
];

const faqs = [
  { q: 'How much does a landscape design cost in Weatherford?', a: 'Most full-yard landscape designs in Weatherford run $8,000–$40,000 installed, depending on scope. Front-yard refreshes start around $3,500. Full backyard transformations with patio, walls, plants, and drainage typically land $25,000–$75,000.' },
  { q: 'Do you charge for the design?', a: 'No — design work is included in the project. Lucas walks the property and writes a detailed proposal at no cost. Once you sign, design refinements happen as part of the project.' },
  { q: 'What does "backyard design" actually include?', a: 'Whatever your yard needs: patio layout, retaining walls, plant beds, sod, drainage, lighting, fire features, and irrigation considerations. We design it as a complete system, not piecemeal add-ons.' },
  { q: 'How long does a full backyard project take?', a: 'A small refresh can be 3–5 days. A medium backyard build with patio, plantings, and drainage is typically 1–2 weeks. Full transformations with multi-tier walls and outdoor living can run 3–6 weeks.' },
  { q: 'Will you handle the plants and the hardscape?', a: 'Yes — one written proposal, one crew, one point of contact. We do not split design and install across vendors. That is how things slip through the cracks.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Landscape Design and Installation',
  provider: { '@type': 'LocalBusiness', name: 'Twin County Outdoor Services', telephone: '(817) 818-9028', address: { '@type': 'PostalAddress', addressLocality: 'Aledo', addressRegion: 'TX', addressCountry: 'US' } },
  areaServed: { '@type': 'City', name: 'Weatherford', containedInPlace: { '@type': 'State', name: 'Texas' } },
  description,
};
---
<Base title={title} description={description} path={path} schema={schema}>
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Services', href: '/services' }, { label: 'Landscape Design Weatherford' }]} />

  <section class="container-x py-12">
    <h1>Landscape & Backyard Design in Weatherford, TX</h1>
    <p class="mt-4 text-lg text-brand-muted max-w-3xl">
      Full landscape design, backyard transformations, and front-yard refreshes across Weatherford and Parker County. Lucas walks every property in person, writes a detailed proposal, and the same crew does every phase of the install — from drainage to plantings.
    </p>

    <div class="mt-8 grid lg:grid-cols-3 gap-10">
      <div class="lg:col-span-2 space-y-10">
        <div class="aspect-[16/10] bg-brand-green-tint rounded-lg overflow-hidden">
          <img src="/images/services/landscape-design/favorite-1-gallery.webp" alt="Landscape design and backyard transformation in Weatherford, TX" width="1600" height="1000" class="w-full h-full object-cover" />
        </div>

        <div>
          <h2>What we design and install</h2>
          <div class="mt-5 grid sm:grid-cols-2 gap-5">
            {services.map((s) => (
              <div class="bg-white border border-brand-green-tint rounded-lg p-5">
                <h3 class="text-lg font-semibold text-brand-ink">{s.name}</h3>
                <p class="mt-2 text-brand-muted text-sm">{s.body}</p>
              </div>
            ))}
          </div>
        </div>

        <div>
          <h2>Our design process</h2>
          <div class="mt-5 grid sm:grid-cols-2 gap-4">
            {process.map((p) => (
              <div class="bg-brand-green-tint/30 rounded-lg p-5">
                <div class="text-brand-green-dark font-bold text-2xl">{p.step}</div>
                <h3 class="text-lg font-semibold text-brand-ink mt-1">{p.title}</h3>
                <p class="mt-2 text-brand-muted text-sm">{p.body}</p>
              </div>
            ))}
          </div>
        </div>

        <div>
          <h2>Recent Weatherford-area work</h2>
          <div class="mt-4 grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4">
            {galleryImages.map((img) => (
              <a href={img.src} class="block aspect-square bg-brand-green-tint rounded-md overflow-hidden">
                <img src={img.src} alt={img.alt} loading="lazy" width="800" height="800" class="w-full h-full object-cover" />
              </a>
            ))}
          </div>
        </div>

        <div>
          <h2>Weatherford landscape design FAQs</h2>
          <div class="mt-4 space-y-5">
            {faqs.map((f) => (
              <div class="border-l-4 border-brand-green-dark pl-4">
                <h3 class="text-lg font-semibold text-brand-ink">{f.q}</h3>
                <p class="mt-2 text-brand-muted">{f.a}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <aside class="lg:sticky lg:top-24 lg:self-start"><QuoteForm compact /></aside>
    </div>
  </section>

  <CTABanner title="Ready to design your Weatherford backyard?" />
</Base>
