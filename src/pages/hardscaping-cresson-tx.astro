---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import QuoteForm from '../components/QuoteForm.astro';
import CTABanner from '../components/CTABanner.astro';
import GeoLinks from '../components/GeoLinks.astro';

const title = 'Hardscape Contractors in Cresson, TX | Twin County Outdoor Services';
const description = 'Hardscape contractors in Cresson, TX — paver patios, flagstone, walkways, and retaining walls for acreage and ranch properties at the corner of Parker, Hood, and Johnson counties. Free in-person quote.';
const path = '/hardscaping-cresson-tx';

const services = [
  { name: 'Paver patios', body: 'Belgard and Pavestone segmental pavers on a properly compacted base — sized for Cresson acreage properties, not just a standard backyard footprint.' },
  { name: 'Flagstone patios & walkways', body: 'Oklahoma flagstone and Texas-quarried stone with mortared or polymeric-sand joints. A natural fit for the ranch-property look common around Cresson.' },
  { name: 'Entrance walkways', body: 'Stone and paver walkways connecting driveways, entries, and outbuildings on larger tri-county lots.' },
  { name: 'Retaining walls', body: 'Block and stone walls for grade changes and drainage control — common on the rolling terrain where Parker, Hood, and Johnson counties meet.' },
  { name: 'Outdoor living', body: 'Seating walls, fire pits, and patios built as one system, anchored to a proper base — not decorative add-ons.' },
  { name: 'Drainage built in', body: 'Every patio and wall includes grading or French drains sized to Cresson-area clay and rock soil.' },
];

const galleryImages = [
  { src: '/images/services/hardscaping/img-1158-gallery.webp', alt: 'Hardscape patio installation' },
  { src: '/images/services/hardscaping/img-1160-gallery.webp', alt: 'Flagstone patio project' },
  { src: '/images/services/hardscaping/img-1804-gallery.webp', alt: 'Paver patio detail' },
  { src: '/images/services/hardscaping/img-1881-gallery.webp', alt: 'Stone walkway installation' },
  { src: '/images/services/hardscaping/img-2230-gallery.webp', alt: 'Backyard hardscape patio' },
  { src: '/images/services/hardscaping/img-9143-gallery.webp', alt: 'Hardscape and retaining wall combination' },
];

const faqs = [
  { q: 'Do you take on hardscape projects in Cresson, TX?', a: 'Yes — Cresson sits right at the corner of Parker, Hood, and Johnson counties, a short drive from our Aledo base, and it is a regular part of our service area.' },
  { q: 'How much does a paver patio cost in Cresson?', a: 'Most paver patios run $15-$30 per square foot installed; flagstone runs $25-$45 per square foot. Acreage properties with longer walkways or entrance hardscape typically land $10,000-$30,000 depending on scope.' },
  { q: 'Can you build hardscape on acreage and ranch properties, not just subdivision lots?', a: 'Yes — acreage and ranch-property hardscape is common Cresson-area work: entrance walkways, larger patios, and walls sized to the property rather than a standard backyard.' },
  { q: 'Do you handle the retaining wall and drainage side too?', a: 'Yes. Grade changes and drainage are common on Cresson-area terrain, so most hardscape projects here include a retaining wall or French drain component built in from the start, not added later.' },
  { q: 'Do you offer free quotes for Cresson-area projects?', a: 'Yes. Lucas walks the property in person, photographs the site, and writes a detailed proposal at no charge — same process regardless of the drive.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Hardscaping',
  provider: { '@id': 'https://twincountyoutdoorservices.com/#business' },
  areaServed: { '@type': 'City', name: 'Cresson', containedInPlace: { '@type': 'State', name: 'Texas' } },
  description,
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Base title={title} description={description} path={path} schema={[schema, faqSchema]}>
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Services', href: '/services' }, { label: 'Hardscaping Cresson' }]} />

  <section class="container-x py-12">
    <h1>Hardscape Contractors in Cresson, TX</h1>
    <p class="mt-4 text-lg text-brand-muted max-w-3xl">
      Paver patios, flagstone walkways, entrance hardscape, and retaining walls for Cresson-area acreage and ranch properties, at the corner of Parker, Hood, and Johnson counties. In-person quotes, detailed written proposals.
    </p>

    <div class="mt-8 grid lg:grid-cols-3 gap-10">
      <div class="lg:col-span-2 space-y-10">
        <div class="aspect-[16/10] bg-brand-green-tint rounded-lg overflow-hidden">
          <img src="/images/services/hardscaping/img-1158-gallery.webp" alt="Hardscape contractor in Cresson, TX" width="1600" height="1000" class="w-full h-full object-cover" />
        </div>

        <div>
          <h2>What we build in Cresson</h2>
          <div class="mt-5 grid sm:grid-cols-2 gap-5">
            {services.map((s) => (
              <div class="bg-white border border-brand-green-tint rounded-lg p-5">
                <h3 class="text-lg font-semibold text-brand-ink">{s.name}</h3>
                <p class="mt-2 text-brand-muted text-sm">{s.body}</p>
              </div>
            ))}
          </div>
        </div>

        <div>
          <h2>Cresson areas we serve</h2>
          <div class="mt-4 flex flex-wrap gap-2">
            {['Cresson proper', 'Tri-county area', 'Acreage properties'].map((n) => (
              <span class="px-3 py-1 bg-brand-green-tint text-brand-ink rounded-full text-sm">{n}</span>
            ))}
          </div>
        </div>

        <div>
          <h2>Recent hardscape work</h2>
          <div class="mt-4 grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4">
            {galleryImages.map((img) => (
              <a href={img.src} class="block aspect-square bg-brand-green-tint rounded-md overflow-hidden">
                <img src={img.src} alt={img.alt} loading="lazy" width="800" height="800" class="w-full h-full object-cover" />
              </a>
            ))}
          </div>
        </div>

        <div>
          <h2>Cresson hardscaping FAQs</h2>
          <div class="mt-4 space-y-5">
            {faqs.map((f) => (
              <div class="border-l-4 border-brand-green-dark pl-4">
                <h3 class="text-lg font-semibold text-brand-ink">{f.q}</h3>
                <p class="mt-2 text-brand-muted">{f.a}</p>
              </div>
            ))}
          </div>
        </div>

        <p class="text-sm text-brand-muted">Serving Cresson, Aledo, Granbury, and the surrounding Parker, Hood, and Johnson county communities.</p>

        <GeoLinks currentPath={path} />
      </div>

      <aside class="lg:sticky lg:top-24 lg:self-start"><QuoteForm compact /></aside>
    </div>
  </section>

  <CTABanner title="Ready for your Cresson hardscape project?" />
</Base>
