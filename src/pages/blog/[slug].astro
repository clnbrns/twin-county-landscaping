---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTABanner from '../../components/CTABanner.astro';
import { BLOG_POSTS, BLOG_BY_SLUG } from '../../data/blog';
import type { BlogPost } from '../../data/blog';
import { SERVICE_BY_SLUG } from '../../data/services';

export async function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

// Pass authority from posts to money pages: map category -> service hub
// and the geo pages under it.
const SERVICES_FOR_CATEGORY: Record<string, string[]> = {
  'Retaining Walls': ['retaining-walls'],
  'Drainage': ['french-drains'],
  'Hardscaping': ['hardscaping'],
  'Lawn & Sod': ['sod-installation'],
};
const relatedServices = (SERVICES_FOR_CATEGORY[post.category] ?? [])
  .map((s) => SERVICE_BY_SLUG[s])
  .filter(Boolean);
const morePosts = BLOG_POSTS.filter((p) => p.slug !== post.slug)
  .sort((a, b) => (a.category === post.category ? -1 : 1) - (b.category === post.category ? -1 : 1))
  .slice(0, 3);

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
}

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  datePublished: post.publishDate,
  author: { '@type': 'Person', name: 'Lucas' },
  publisher: { '@type': 'Organization', name: 'Twin County Outdoor Services' },
};

const faqSchema = post.faqs
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: post.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a,
        },
      })),
    }
  : null;

const schema = post.faqs && faqSchema ? [articleSchema, faqSchema] : articleSchema;
---

<Base
  title={`${post.title} | Twin County Outdoor Services`}
  description={post.description}
  path={`/blog/${post.slug}`}
  schema={schema}
>
  <Breadcrumb
    items={[
      { label: 'Home', href: '/' },
      { label: 'Blog', href: '/blog' },
      { label: post.title },
    ]}
  />

  <article class="container-x py-12">
    <div class="max-w-3xl">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-xs font-semibold uppercase tracking-wide text-brand-green-dark bg-brand-green-tint px-2 py-0.5 rounded">
          {post.category}
        </span>
      </div>

      <h1 class="text-brand-ink">{post.title}</h1>

      <div class="mt-4 flex items-center gap-3 text-sm text-brand-muted">
        <time datetime={post.publishDate}>{formatDate(post.publishDate)}</time>
        <span aria-hidden="true">&middot;</span>
        <span>{post.readTime}</span>
      </div>

      <div class="mt-8 space-y-6">
        {post.body.map((paragraph) => (
          <p class="text-lg text-brand-ink leading-relaxed">{paragraph}</p>
        ))}
      </div>

      {post.faqs && post.faqs.length > 0 && (
        <div class="mt-10">
          <h2 class="text-brand-ink mb-6">Frequently Asked Questions</h2>
          <div class="space-y-6">
            {post.faqs.map((faq) => (
              <div class="border-l-4 border-brand-green-dark pl-5">
                <h3 class="text-brand-ink font-semibold mb-2">{faq.q}</h3>
                <p class="text-brand-muted">{faq.a}</p>
              </div>
            ))}
          </div>
        </div>
      )}

      {relatedServices.length > 0 && (
        <div class="mt-10 bg-brand-green-tint/30 rounded-lg p-5">
          <h2 class="text-brand-ink text-xl">Need this done, not just explained?</h2>
          <p class="mt-2 text-brand-muted text-sm">We handle this work in person across Aledo, Weatherford, Benbrook, Fort Worth, and Western DFW — free quotes, written proposals.</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {relatedServices.map((s) => (
              <a href={`/services/${s.slug}`} class="px-3 py-1 bg-white border border-brand-green-tint rounded-full text-sm hover:border-brand-green-dark no-underline">{s.name} →</a>
            ))}
          </div>
        </div>
      )}

      {morePosts.length > 0 && (
        <div class="mt-10">
          <h2 class="text-brand-ink text-xl">Keep reading</h2>
          <ul class="mt-3 space-y-2">
            {morePosts.map((p) => (
              <li><a href={`/blog/${p.slug}`}>{p.title}</a></li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </article>

  <CTABanner title="Want a free quote on your project?" />
</Base>
