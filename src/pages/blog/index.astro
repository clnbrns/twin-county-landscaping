---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { BLOG_POSTS } from '../../data/blog';

const title = 'Landscaping Tips & Guides for Western DFW | Twin County';
const description =
  'Honest guides on retaining walls, french drains, sod, hardscaping, and more for North Texas homeowners.';
const path = '/blog';

const posts = [...BLOG_POSTS].sort(
  (a, b) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime(),
);

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
}
---

<Base title={title} description={description} path={path}>
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Blog' }]} />

  <section class="container-x py-12">
    <h1 class="text-brand-ink">Landscaping Tips &amp; Guides</h1>
    <p class="mt-4 text-lg text-brand-muted max-w-3xl">
      Honest answers for North Texas homeowners — retaining walls, drainage, sod, pavers, and more.
      No fluff, no upsells. Just what you need to know before you hire anyone.
    </p>

    <div class="mt-10 grid lg:grid-cols-2 gap-8">
      {posts.map((post) => (
        <article class="border border-brand-green-tint rounded-lg overflow-hidden flex flex-col">
          <div class="p-6 flex flex-col flex-1">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-xs font-semibold uppercase tracking-wide text-brand-green-dark bg-brand-green-tint px-2 py-0.5 rounded">
                {post.category}
              </span>
            </div>
            <h2 class="text-xl text-brand-ink leading-snug">
              <a href={`/blog/${post.slug}`} class="hover:text-brand-green-dark no-underline">
                {post.title}
              </a>
            </h2>
            <p class="mt-3 text-brand-muted flex-1">{post.description}</p>
            <div class="mt-4 flex items-center gap-3 text-sm text-brand-muted">
              <time datetime={post.publishDate}>{formatDate(post.publishDate)}</time>
              <span aria-hidden="true">&middot;</span>
              <span>{post.readTime}</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</Base>
