---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTABanner from '../../components/CTABanner.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import { AREAS, AREA_BY_SLUG } from '../../data/areas';
import { SERVICES } from '../../data/services';
import { SERVICE_IMAGES } from '../../data/serviceImages';
import { GEO_PAGES_BY_CITY } from '../../data/geoPages';
import { PROJECTS } from '../../data/projects';

export function getStaticPaths() {
  return AREAS.map((a) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;
const area = AREA_BY_SLUG[slug as string];

const title = `Landscaping & Hardscape Services in ${area.city}, ${area.state} | Twin County Outdoor Services`;
const description = `Landscape design, retaining walls, hardscaping, sod, and drainage services in ${area.city}, ${area.state}. Free in-person quotes from Twin County Outdoor Services.`;

// City-specific landing pages, driven by the central registry so new
// geo pages surface here automatically.
const featured = GEO_PAGES_BY_CITY[area.slug] ?? [];
const cityProjects = PROJECTS.filter((p) => p.city === area.city);
---
<Base title={title} description={description} path={`/areas/${area.slug}`}>
  <Breadcrumb items={[
    { label: 'Home', href: '/' },
    { label: 'Service Areas', href: '/areas' },
    { label: `${area.city}, ${area.state}` },
  ]} />

  <section class="container-x py-12">
    <h1>Landscaping & Hardscape Services in {area.city}, {area.state}</h1>
    <p class="mt-4 text-lg text-brand-muted max-w-3xl">{area.intro}</p>

    {area.neighborhoods.length > 0 && (
      <div class="mt-8">
        <h2 class="text-2xl">Neighborhoods we serve in {area.city}</h2>
        <div class="mt-3 flex flex-wrap gap-2">
          {area.neighborhoods.map((n) => (
            <span class="px-3 py-1 bg-brand-green-tint text-brand-ink rounded-full text-sm">{n}</span>
          ))}
        </div>
      </div>
    )}

    {featured.length > 0 && (
      <div class="mt-12">
        <h2>Featured services in {area.city}</h2>
        <p class="mt-2 text-brand-muted">Detailed pages for the projects we get asked about most in {area.city}.</p>
        <div class="mt-5 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {featured.map((f) => (
            <a href={f.href} class="block bg-white border border-brand-green-tint rounded-lg p-5 hover:border-brand-green-dark transition-colors no-underline">
              <h3 class="text-lg font-semibold text-brand-ink">{f.title} →</h3>
              <p class="mt-2 text-brand-muted text-sm">{f.blurb}</p>
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="mt-12">
      <h2>Services available in {area.city}</h2>
      <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {SERVICES.map((s) => <ServiceCard slug={s.slug} name={s.name} short={s.short} image={SERVICE_IMAGES[s.slug]?.card} />)}
      </div>
    </div>

    {cityProjects.length > 0 && (
      <div class="mt-12">
        <h2>Recent work in {area.city}</h2>
        <p class="mt-2 text-brand-muted">Real {area.city} projects — photos, materials, and the story behind each build.</p>
        <div class="mt-5 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {cityProjects.map((p) => (
            <a href={`/projects/${p.slug}`} class="block bg-white border border-brand-green-tint rounded-lg overflow-hidden hover:border-brand-green-dark transition-colors no-underline">
              <div class="aspect-[4/3] bg-brand-green-tint">
                <img src={p.hero} alt={p.title} loading="lazy" width="800" height="600" class="w-full h-full object-cover" />
              </div>
              <div class="p-4">
                <h3 class="text-base font-semibold text-brand-ink">{p.title}</h3>
                <p class="mt-1 text-brand-muted text-sm line-clamp-2">{p.summary}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="mt-12 grid lg:grid-cols-2 gap-8 items-start">
      <div>
        <h2>About Twin County in {area.city}</h2>
        <p class="mt-3 text-brand-muted">We've worked throughout {area.city} and the surrounding communities. Lucas walks every property in person and provides a detailed written proposal with full scope of work — no remote quotes, no guessing.</p>
      </div>
      <QuoteForm compact />
    </div>
  </section>

  <CTABanner title={`Ready for your ${area.city} project?`} />
</Base>
