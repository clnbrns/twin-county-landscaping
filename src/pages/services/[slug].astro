---
import Base from '../../layouts/Base.astro';
import CTABanner from '../../components/CTABanner.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import BeforeAfterSlider from '../../components/BeforeAfterSlider.astro';
import { SERVICES, SERVICE_BY_SLUG } from '../../data/services';
import { SERVICE_IMAGES } from '../../data/serviceImages';
import { BEFORE_AFTER } from '../../data/beforeAfter';
import { GEO_PAGES_BY_SERVICE } from '../../data/geoPages';
import { BLOG_POSTS } from '../../data/blog';
import { AREAS } from '../../data/areas';
import { SITE } from '../../data/site';

export function getStaticPaths() {
  return SERVICES.map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const service = SERVICE_BY_SLUG[slug as string];
const related = service.related.map((r) => SERVICE_BY_SLUG[r]).filter(Boolean);
const images = SERVICE_IMAGES[service.slug];

// Per-slug hero override (when alphabetical first photo isn't the best opener).
const HERO_OVERRIDES: Record<string, string> = {
  'tree-services': '/images/services/tree-services/img-1165-gallery.webp',
  'plant-installation': '/images/services/flower-beds/img-0269-gallery.webp',
  'mulch-installation': '/images/services/mulch-installation/img-5500-gallery.webp',
  'leveling-grading': '/images/services/leveling-grading/img-2457-gallery.webp',
};
const heroOverride = HERO_OVERRIDES[service.slug];
const hero = heroOverride ?? images?.gallery[0] ?? '/images/placeholder-hero.svg';
const gallery = (images?.gallery ?? []).filter((src) => src !== hero);
const beforeAfterPairs = BEFORE_AFTER[service.slug] ?? [];

const SEO_OVERRIDES: Record<string, { title?: string; description?: string; aka?: string[] }> = {
  'retaining-walls': {
    title: 'Retaining Wall Contractors | Keller, Aledo, Saginaw & Western DFW | Twin County',
    description: 'Retaining wall contractors in Keller, Aledo, Saginaw, Azle, NRH, and Western DFW. Block, stone, and poured walls engineered for drainage and built to last 30+ years. Free in-person quote.',
    aka: ['retaining wall contractors', 'retaining wall builders', 'segmental wall installation'],
  },
  'hardscaping': {
    title: 'Hardscape Contractors & Patio Installation Near Aledo, TX | Twin County',
    description: 'Hardscape contractors near you. Paver patios, flagstone patios, walkways, and concrete pads installed across Aledo, Fort Worth, Weatherford, and Western DFW.',
    aka: ['hardscape contractors near me', 'patio installation near me', 'flagstone patio installation', 'paver patio contractors'],
  },
  'sod-installation': {
    title: 'Sod Installation Near Aledo, TX & Western DFW | Twin County',
    description: 'Sod installation near you in Aledo, Fort Worth, Weatherford, and Western DFW. Bermuda, Zoysia, and St. Augustine — graded, prepped, and laid right. $3,000 minimum.',
    aka: ['sod installation near me', 'sod company near me', 'new sod installation'],
  },
  'french-drains': {
    title: 'French Drain Installation | Aledo, Saginaw, Azle & Western DFW | Twin County',
    description: 'French drain installation in Aledo, Saginaw, Azle, Keller, and Western DFW. We fix standing water and soggy yards for good — designed for Texas clay soil. Free in-person quote.',
    aka: ['french drain installation near me', 'drainage specialist near me', 'yard drainage contractors'],
  },
  'landscape-design': {
    title: 'Landscape Design & Backyard Landscaping in Aledo, TX | Twin County',
    description: 'Backyard landscaping and full landscape design across Aledo, Fort Worth, Weatherford, and Western DFW. CAD-designed plans, plant selection, and complete in-house installation.',
    aka: ['backyard landscaping', 'backyard design', 'landscape designers near me', 'best landscapers near me'],
  },
  'stone-borders': {
    title: 'Stone Borders & Lawn Edging Near Me | Aledo, TX | Twin County',
    description: 'Stone borders and lawn edging near you in Aledo, Fort Worth, Weatherford, and Western DFW. Clean, durable bed and tree-ring edging set to last. Free in-person quote.',
    aka: ['lawn edging', 'stone landscape edging', 'natural stone borders', 'stone borders near me'],
  },
};

// Hub-and-spoke: link this service hub to its city-specific landing pages.
const cityPages = GEO_PAGES_BY_SERVICE[service.slug] ?? [];

// Related blog posts, matched by category.
const BLOG_CATEGORY_FOR_SERVICE: Record<string, string> = {
  'retaining-walls': 'Retaining Walls',
  'french-drains': 'Drainage',
  'hardscaping': 'Hardscaping',
  'sod-installation': 'Lawn & Sod',
};
const relatedPosts = BLOG_POSTS.filter((p) => p.category === BLOG_CATEGORY_FOR_SERVICE[service.slug]);

const seo = SEO_OVERRIDES[service.slug] ?? {};
const title = seo.title ?? `${service.name} in Aledo, TX | Twin County Outdoor Services`;
const description = seo.description ?? `${service.short} Serving Aledo, Benbrook, Weatherford, Fort Worth, and Western DFW. Free in-person quotes from Twin County Outdoor Services.`;
const aka = seo.aka ?? [];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: service.name,
  provider: { '@id': `${SITE.url}/#business` },
  areaServed: AREAS.map((a) => ({ '@type': 'City', name: a.city, containedInPlace: { '@type': 'State', name: a.state } })),
  description,
};
---
<Base title={title} description={description} path={`/services/${service.slug}`} schema={schema}>
  <Breadcrumb items={[
    { label: 'Home', href: '/' },
    { label: 'Services', href: '/services' },
    { label: service.name },
  ]} />

  <section class="container-x py-12">
    <h1>{service.name} in Aledo, TX</h1>
    <p class="mt-4 text-lg text-brand-muted max-w-3xl">{service.intro}</p>
    {aka.length > 0 && (
      <p class="mt-3 text-sm text-brand-muted max-w-3xl">Also known as: {aka.join(' · ')}.</p>
    )}

    <div class="mt-10 grid lg:grid-cols-3 gap-10">
      <div class="lg:col-span-2 space-y-10">
        <div class="aspect-[16/10] bg-brand-green-tint rounded-lg overflow-hidden">
          <img src={hero} alt={`${service.name} project in Aledo, TX`} width="1600" height="1000" class="w-full h-full object-cover" />
        </div>

        {beforeAfterPairs.length > 0 && (
          <div>
            <h2>Before &amp; after</h2>
            <p class="mt-2 text-brand-muted text-sm">Drag the slider to compare. Real {service.name.toLowerCase()} jobs from Western DFW.</p>
            <div class="mt-4 space-y-6">
              {beforeAfterPairs.map((pair) => (
                <figure>
                  <BeforeAfterSlider before={pair.before} after={pair.after} alt={`${service.name} before and after`} />
                  {pair.caption && <figcaption class="mt-2 text-sm text-brand-muted">{pair.caption}</figcaption>}
                </figure>
              ))}
            </div>
          </div>
        )}

        {gallery.length > 0 && (
          <div>
            <h2>Recent {service.name.toLowerCase()} work</h2>
            <div class="mt-4 grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4">
              {gallery.map((src) => (
                <div class="aspect-square bg-brand-green-tint rounded-md overflow-hidden">
                  <img src={src} alt={`${service.name} project photo`} width="800" height="800" loading="lazy" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
                </div>
              ))}
            </div>
          </div>
        )}

        <div>
          <h2>What's included</h2>
          <ul class="mt-4 space-y-2">
            {service.included.map((item) => (
              <li class="flex gap-3"><span class="text-brand-green-dark font-bold">✓</span><span>{item}</span></li>
            ))}
          </ul>
        </div>

        <div class="bg-brand-green-tint p-6 rounded-lg">
          <h3>Why Lucas</h3>
          <p class="mt-2 text-brand-ink">Every {service.name.toLowerCase()} job starts with an in-person walkthrough and a detailed written proposal. Lucas is on every job — Aledo local, owner-operated, no random crews.</p>
        </div>

        {cityPages.length > 0 && (
          <div>
            <h2>{service.name} by city</h2>
            <p class="mt-2 text-brand-muted text-sm">Detailed local pages with city-specific pricing, permits, and FAQs.</p>
            <div class="mt-4 grid sm:grid-cols-2 gap-4">
              {cityPages.map((p) => (
                <a href={p.href} class="block bg-white border border-brand-green-tint rounded-lg p-4 hover:border-brand-green-dark transition-colors no-underline">
                  <div class="font-semibold text-brand-ink">{p.title} →</div>
                  <p class="mt-1 text-brand-muted text-sm">{p.blurb}</p>
                </a>
              ))}
            </div>
          </div>
        )}

        {relatedPosts.length > 0 && (
          <div>
            <h3>Guides &amp; pricing articles</h3>
            <ul class="mt-3 space-y-2">
              {relatedPosts.map((p) => (
                <li><a href={`/blog/${p.slug}`}>{p.title}</a></li>
              ))}
            </ul>
          </div>
        )}

        {related.length > 0 && (
          <div>
            <h3>Related services</h3>
            <div class="mt-3 flex flex-wrap gap-2">
              {related.map((r) => (
                <a href={`/services/${r.slug}`} class="px-3 py-1 bg-white border border-brand-green-tint rounded-full text-sm hover:border-brand-green-dark no-underline">{r.name}</a>
              ))}
            </div>
          </div>
        )}

        <p class="text-sm text-brand-muted">Serving Aledo, Benbrook, Weatherford, Fort Worth, Brock, and surrounding areas.</p>
      </div>

      <aside class="lg:sticky lg:top-24 self-start">
        <QuoteForm compact />
      </aside>
    </div>
  </section>
  <CTABanner />
</Base>
