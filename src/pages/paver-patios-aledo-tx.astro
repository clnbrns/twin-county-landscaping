---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import QuoteForm from '../components/QuoteForm.astro';
import CTABanner from '../components/CTABanner.astro';

const title = 'Paver Patio Contractors in Aledo, TX | Twin County Outdoor Services';
const description = 'Paver patio installation in Aledo, TX. Belgard, Pavestone, and flagstone patios — properly excavated, compacted base, drainage built in. In-person quotes, written proposals.';
const path = '/paver-patios-aledo-tx';

const services = [
  { name: 'Paver patios', body: 'Belgard, Pavestone, and Acker-Stone segmental pavers on a properly compacted base. Patterns, borders, banding — built to drain and stay flat for decades.' },
  { name: 'Flagstone patios', body: 'SilverMist, Oklahoma, and Texas-quarried flagstone with mortared or polymeric-sand joints. The premium Aledo patio look.' },
  { name: 'Walkways & paths', body: 'Front-walk and side-yard paver paths that tie into the patio language. Same base prep, same edge restraints, same drainage thinking.' },
  { name: 'Pool decks & coping', body: 'Pool surrounds installed over compacted base with proper expansion gaps. Cool-deck pavers for Texas summer comfort.' },
  { name: 'Driveways & parking pads', body: 'Heavy-duty paver applications with engineered base and concrete edge restraint. Rare ask but we do it right when needed.' },
  { name: 'Steps & elevation changes', body: 'Stone steps and short retaining courses for sloped Aledo lots. Built in to the patio system, not bolted on.' },
];

const galleryImages = [
  { src: '/images/projects/benbrook-flagstone-patio/img-2230-gallery.webp', alt: 'Flagstone patio in Aledo area' },
  { src: '/images/projects/benbrook-flagstone-patio/img-2232-gallery.webp', alt: 'SilverMist flagstone with gray masonry joints' },
  { src: '/images/projects/benbrook-flagstone-patio/img-2234-gallery.webp', alt: 'Flagstone patio detail with steps' },
  { src: '/images/projects/benbrook-flagstone-patio/img-2235-gallery.webp', alt: 'Patio installation detail' },
  { src: '/images/services/hardscaping/img-0040-gallery.webp', alt: 'Paver patio in Aledo' },
  { src: '/images/services/hardscaping/img-0041-gallery.webp', alt: 'Hardscape walkway installation' },
];

const whyItFails = [
  { title: 'Skipped base prep', body: 'Cheap installs go straight on dirt or 2 inches of base. Ours go on 6–8 inches of compacted crushed concrete or limestone, screeded flat in lifts.' },
  { title: 'No edge restraint', body: 'Without a concrete or steel edge holding the pavers in, the outer rows shift, gap, and tilt within a year. Non-negotiable on every job.' },
  { title: 'No drainage', body: 'Water trapped under a patio softens the base and the whole thing settles unevenly. We slope to drain and add subsurface drainage where the grade demands it.' },
  { title: 'Wrong sand', body: 'Standard masonry sand washes out. We use polymeric joint sand that locks the pavers and resists weeds and ants.' },
];

const faqs = [
  { q: 'How much does a paver patio cost in Aledo?', a: 'Most paver patios in Aledo run $15–$30 per square foot installed, depending on paver selection, base depth, pattern complexity, borders, and steps. Flagstone runs $25–$45 per square foot. Average Aledo patio project lands $8,000–$25,000.' },
  { q: 'How long will a properly installed patio last?', a: 'A patio built on a 6–8 inch compacted base with edge restraint and polymeric joint sand should perform 20+ years with no settling. The pavers themselves last essentially forever — what fails on cheap installs is the base.' },
  { q: 'Can you tear out my existing patio and replace it?', a: 'Yes — included in the quote. We remove old concrete, broken pavers, or failing flagstone, haul it away, prep the base properly, and install the new patio. Demo is part of the project, not a surprise add-on.' },
  { q: 'Do you do flagstone or pavers? Which should I choose?', a: 'We do both. Pavers (Belgard, Pavestone) are more uniform, easier to maintain, and slightly cheaper. Flagstone has more character, varies in color, and reads as more high-end. Lucas walks you through both options at the quote.' },
  { q: 'How long does it take?', a: 'A standard 300–500 sq ft patio takes 2–4 days. Larger patios with steps, walls, and drainage can take a week. Flagstone takes longer than pavers due to the cut-and-fit work.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Paver Patio Installation',
  provider: { '@type': 'LocalBusiness', name: 'Twin County Outdoor Services', telephone: '(817) 818-9028', address: { '@type': 'PostalAddress', addressLocality: 'Aledo', addressRegion: 'TX', addressCountry: 'US' } },
  areaServed: { '@type': 'City', name: 'Aledo', containedInPlace: { '@type': 'State', name: 'Texas' } },
  description,
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Base title={title} description={description} path={path} schema={[schema, faqSchema]}>
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Services', href: '/services' }, { label: 'Paver Patios Aledo' }]} />

  <section class="container-x py-12">
    <h1>Paver Patio Contractors in Aledo, TX</h1>
    <p class="mt-4 text-lg text-brand-muted max-w-3xl">
      Paver patios, flagstone patios, walkways, and pool decks — installed across Aledo and Western DFW with the base prep, edge restraint, and drainage that make a patio actually last. Lucas was raised here and walks every job in person.
    </p>

    <div class="mt-8 grid lg:grid-cols-3 gap-10">
      <div class="lg:col-span-2 space-y-10">
        <div class="aspect-[16/10] bg-brand-green-tint rounded-lg overflow-hidden">
          <img src="/images/projects/benbrook-flagstone-patio/img-2230-gallery.webp" alt="Paver patio contractor in Aledo, TX — flagstone patio with steps" width="1600" height="1000" class="w-full h-full object-cover" />
        </div>

        <div>
          <h2>What we install in Aledo</h2>
          <div class="mt-5 grid sm:grid-cols-2 gap-5">
            {services.map((s) => (
              <div class="bg-white border border-brand-green-tint rounded-lg p-5">
                <h3 class="text-lg font-semibold text-brand-ink">{s.name}</h3>
                <p class="mt-2 text-brand-muted text-sm">{s.body}</p>
              </div>
            ))}
          </div>
        </div>

        <div>
          <h2>Why most patios fail (and why ours don't)</h2>
          <div class="mt-5 grid sm:grid-cols-2 gap-4">
            {whyItFails.map((w) => (
              <div class="bg-brand-green-tint/30 rounded-lg p-5">
                <h3 class="text-lg font-semibold text-brand-ink">{w.title}</h3>
                <p class="mt-2 text-brand-muted text-sm">{w.body}</p>
              </div>
            ))}
          </div>
        </div>

        <div>
          <h2>Recent patio work</h2>
          <div class="mt-4 grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4">
            {galleryImages.map((img) => (
              <a href={img.src} class="block aspect-square bg-brand-green-tint rounded-md overflow-hidden">
                <img src={img.src} alt={img.alt} loading="lazy" width="800" height="800" class="w-full h-full object-cover" />
              </a>
            ))}
          </div>
        </div>

        <div>
          <h2>Aledo paver patio FAQs</h2>
          <div class="mt-4 space-y-5">
            {faqs.map((f) => (
              <div class="border-l-4 border-brand-green-dark pl-4">
                <h3 class="text-lg font-semibold text-brand-ink">{f.q}</h3>
                <p class="mt-2 text-brand-muted">{f.a}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <aside class="lg:sticky lg:top-24 lg:self-start"><QuoteForm compact /></aside>
    </div>
  </section>

  <CTABanner title="Ready for a patio in Aledo?" />
</Base>
